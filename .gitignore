# Byte-compiled files recursively across all subdirectories
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Distribution & packaging recursively
**/build/
**/dist/
**/downloads/
**/*.egg-info/
**/*.egg

# Virtual environments recursively at any depth
**/.venv/
**/venv/
**/env/
**/.env

# Test & cache coverage recursively
**/.pytest_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/

# IDE / Editor configs recursively
**/.idea/
**/.vscode/
**/*.swp
*/**/.opencode
